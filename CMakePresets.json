{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (native)",
            "description": "Native build using system SDL2",
            "binaryDir": "${sourceDir}/build",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "web",
            "displayName": "Web (Emscripten)",
            "description": "WebAssembly build via Emscripten — requires emsdk_env.sh to be sourced; if your distro Emscripten package freezes /usr/share/emscripten/cache, create a repo-local .emscripten-local config and .emscripten-cache as described in web/README.md",
            "binaryDir": "${sourceDir}/build-web",
            "generator": "Unix Makefiles",
            "toolchainFile": "${sourceDir}/cmake/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "web-debug",
            "displayName": "Web Debug (Emscripten)",
            "description": "Debug WebAssembly build — source maps, assertions, no optimisation; on frozen-cache distro packages use the same repo-local .emscripten-local/.emscripten-cache workaround as the web preset",
            "binaryDir": "${sourceDir}/build-web-debug",
            "generator": "Unix Makefiles",
            "toolchainFile": "${sourceDir}/cmake/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "win64",
            "displayName": "Windows x86-64 (MinGW-w64 cross)",
            "description": "Cross-compile a Windows .exe from Linux using MinGW-w64. Requires: sudo apt install mingw-w64 and SDL2 MinGW dev package at ~/dev/windows/SDL2-2.30.3/",
            "binaryDir": "${sourceDir}/build-win",
            "generator": "Unix Makefiles",
            "toolchainFile": "${sourceDir}/cmake/MinGW-w64.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SDL2_DIR": "$env{HOME}/dev/windows/SDL2-2.30.3/x86_64-w64-mingw32/lib/cmake/SDL2"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "web",
            "configurePreset": "web"
        },
        {
            "name": "web-debug",
            "configurePreset": "web-debug"
        },
        {
            "name": "win64",
            "configurePreset": "win64"
        }
    ]
}
